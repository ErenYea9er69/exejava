<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane prefHeight="520.0" prefWidth="650.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ControllerEtudiant">

    <!-- Title -->
    <Label layoutX="240.0" layoutY="10.0" text="Gestion Etudiants">
        <font>
            <Font name="System Bold" size="18.0"/>
        </font>
    </Label>

    <!-- Informations Etudiant Section -->
    <TitledPane animated="false" collapsible="false" layoutX="14.0" layoutY="45.0"
                prefWidth="430.0" text="Informations Etudiant">
        <AnchorPane prefHeight="100.0">
            <!-- Nom -->
            <Label layoutX="14.0" layoutY="15.0" text="Nom :"/>
            <TextField fx:id="tfNom" layoutX="80.0" layoutY="12.0" prefWidth="150.0"/>

            <!-- Sexe -->
            <Label layoutX="250.0" layoutY="15.0" text="Sexe :"/>
            <RadioButton fx:id="rbFemme" layoutX="300.0" layoutY="15.0" text="F">
                <toggleGroup>
                    <ToggleGroup fx:id="sexeGroup"/>
                </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="rbHomme" layoutX="350.0" layoutY="15.0" text="M"
                         toggleGroup="$sexeGroup"/>

            <!-- Prenom -->
            <Label layoutX="14.0" layoutY="55.0" text="Prenom :"/>
            <TextField fx:id="tfPrenom" layoutX="80.0" layoutY="52.0" prefWidth="150.0"/>

            <!-- Filiere -->
            <Label layoutX="250.0" layoutY="55.0" text="Filière :"/>
            <ComboBox fx:id="cbFiliere" layoutX="310.0" layoutY="52.0" prefWidth="90.0">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="DSI"/>
                        <String fx:value="RSI"/>
                        <String fx:value="SEM"/>
                        <String fx:value="GC"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </AnchorPane>
    </TitledPane>

    <!-- Buttons -->
    <VBox layoutX="470.0" layoutY="65.0" spacing="10.0">
        <Button fx:id="btnAjouter" onAction="#handleAjouter" prefWidth="120.0" prefHeight="30.0" text="Ajouter"/>
        <Button fx:id="btnSupprimer" onAction="#handleSupprimer" prefWidth="120.0" prefHeight="30.0" text="Supprimer"/>
        <Button fx:id="btnModifier" onAction="#handleModifier" prefWidth="120.0" prefHeight="30.0" text="Modifier"/>
    </VBox>

    <!-- Liste des étudiants Section -->
    <TitledPane animated="false" collapsible="false" layoutX="14.0" layoutY="220.0"
                prefWidth="620.0" text="Liste des étudiants">
        <TableView fx:id="tableEtudiants" prefHeight="240.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
                <TableColumn fx:id="colNom" prefWidth="130.0" text="Nom"/>
                <TableColumn fx:id="colPrenom" prefWidth="130.0" text="Prenom"/>
                <TableColumn fx:id="colSexe" prefWidth="100.0" text="Sexe"/>
                <TableColumn fx:id="colFiliere" prefWidth="130.0" text="Filière"/>
            </columns>
        </TableView>
    </TitledPane>

</AnchorPane>
